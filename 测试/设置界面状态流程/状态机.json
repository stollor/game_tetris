{
  "version": 1,
  "name": "设置界面功能流程",
  "initialState": "主界面",
  "timeoutMs": 5000,
  "steps": [
    {
      "name": "打开设置",
      "from": "主界面",
      "action": "menu.settings",
      "to": "设置界面"
    },
    {
      "name": "建立默认设置基线",
      "from": "设置界面",
      "action": "settings.defaults",
      "to": "设置界面",
      "expectStorage": {
        "gamemaker:settings": {
          "背景音乐": true,
          "音乐音量": 60,
          "音效音量": 80,
          "主题": "跟随系统",
          "语言": "跟随系统",
          "样式": "夜空鎏金"
        }
      }
    },
    {
      "name": "关闭背景音乐",
      "from": "设置界面",
      "action": "settings.music.off",
      "to": "设置界面",
      "expectStorage": {
        "gamemaker:settings": {
          "背景音乐": false
        }
      }
    },
    {
      "name": "打开背景音乐",
      "from": "设置界面",
      "action": "settings.music.on",
      "to": "设置界面",
      "expectStorage": {
        "gamemaker:settings": {
          "背景音乐": true
        }
      }
    },
    {
      "name": "通过滑块设置音乐音量",
      "from": "设置界面",
      "action": "settings.music-volume.slider",
      "value": 45,
      "to": "设置界面",
      "expectStorage": {
        "gamemaker:settings": {
          "音乐音量": 45
        }
      }
    },
    {
      "name": "调低音乐音量",
      "from": "设置界面",
      "action": "settings.music-volume.down",
      "to": "设置界面",
      "expectStorage": {
        "gamemaker:settings": {
          "音乐音量": 35
        }
      }
    },
    {
      "name": "调高音乐音量",
      "from": "设置界面",
      "action": "settings.music-volume.up",
      "to": "设置界面",
      "expectStorage": {
        "gamemaker:settings": {
          "音乐音量": 45
        }
      }
    },
    {
      "name": "通过滑块设置音效音量",
      "from": "设置界面",
      "action": "settings.sfx-volume.slider",
      "value": 65,
      "to": "设置界面",
      "expectStorage": {
        "gamemaker:settings": {
          "音效音量": 65
        }
      }
    },
    {
      "name": "调低音效音量",
      "from": "设置界面",
      "action": "settings.sfx-volume.down",
      "to": "设置界面",
      "expectStorage": {
        "gamemaker:settings": {
          "音效音量": 55
        }
      }
    },
    {
      "name": "调高音效音量",
      "from": "设置界面",
      "action": "settings.sfx-volume.up",
      "to": "设置界面",
      "expectStorage": {
        "gamemaker:settings": {
          "音效音量": 65
        }
      }
    },
    {
      "name": "切换深色主题",
      "from": "设置界面",
      "action": "settings.theme.dark",
      "to": "设置界面",
      "expectStorage": {
        "gamemaker:settings": {
          "主题": "深色"
        }
      }
    },
    {
      "name": "切换浅色主题",
      "from": "设置界面",
      "action": "settings.theme.light",
      "to": "设置界面",
      "expectStorage": {
        "gamemaker:settings": {
          "主题": "浅色"
        }
      }
    },
    {
      "name": "切换样式方案",
      "from": "设置界面",
      "action": "settings.style.warm-paper",
      "to": "设置界面",
      "expectStorage": {
        "gamemaker:settings": {
          "样式": "暖纸古典"
        }
      }
    },
    {
      "name": "主题跟随系统",
      "from": "设置界面",
      "action": "settings.theme.system",
      "to": "设置界面",
      "expectStorage": {
        "gamemaker:settings": {
          "主题": "跟随系统"
        }
      }
    },
    {
      "name": "展开语言下拉菜单",
      "from": "设置界面",
      "action": "settings.language.dropdown",
      "to": "设置界面"
    },
    {
      "name": "切换英文界面",
      "from": "设置界面",
      "action": "settings.language.en",
      "to": "设置界面",
      "expectStorage": {
        "gamemaker:settings": {
          "语言": "English"
        }
      }
    },
    {
      "name": "再次展开语言下拉菜单",
      "from": "设置界面",
      "action": "settings.language.dropdown",
      "to": "设置界面"
    },
    {
      "name": "切换中文界面",
      "from": "设置界面",
      "action": "settings.language.zh",
      "to": "设置界面",
      "expectStorage": {
        "gamemaker:settings": {
          "语言": "简体中文"
        }
      }
    },
    {
      "name": "恢复默认设置",
      "from": "设置界面",
      "action": "settings.defaults",
      "to": "设置界面",
      "expectStorage": {
        "gamemaker:settings": {
          "背景音乐": true,
          "音乐音量": 60,
          "音效音量": 80,
          "主题": "跟随系统",
          "语言": "跟随系统",
          "样式": "夜空鎏金"
        }
      }
    },
    {
      "name": "完成并关闭",
      "from": "设置界面",
      "action": "settings.done",
      "to": "主界面"
    }
  ]
}
