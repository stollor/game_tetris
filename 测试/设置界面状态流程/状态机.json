{
  "version": 1,
  "name": "设置界面功能流程",
  "initialState": "开始菜单",
  "timeoutMs": 5000,
  "steps": [
    {
      "name": "打开设置",
      "from": "开始菜单",
      "action": "menu.settings",
      "to": "设置界面"
    },
    {
      "name": "建立默认设置基线",
      "from": "设置界面",
      "action": "settings.defaults",
      "to": "设置界面",
      "expectStorage": {
        "gamemaker:settings": {
          "背景音乐": true,
          "音乐音量": 60,
          "音效音量": 80,
          "旋转180": true,
          "主题": "跟随系统",
          "语言": "跟随系统",
          "样式": "夜空鎏金"
        }
      }
    },
    {
      "name": "关闭 180° 旋转",
      "from": "设置界面",
      "action": "settings.rotation180.off",
      "to": "设置界面",
      "expectStorage": {
        "gamemaker:settings": {
          "旋转180": false,
          "背景音乐": true,
          "音乐音量": 60,
          "音效音量": 80
        }
      }
    },
    {
      "name": "重新开启 180° 旋转",
      "from": "设置界面",
      "action": "settings.rotation180.on",
      "to": "设置界面",
      "expectStorage": {
        "gamemaker:settings": {
          "旋转180": true,
          "背景音乐": true,
          "音乐音量": 60,
          "音效音量": 80
        }
      }
    },
    {
      "name": "选择暖纸古典样式",
      "from": "设置界面",
      "action": "settings.style.warm-paper",
      "to": "设置界面",
      "expectStorage": {
        "gamemaker:settings": {
          "样式": "暖纸古典"
        }
      }
    },
    {
      "name": "选择极光原野样式",
      "from": "设置界面",
      "action": "settings.style.neon-tide",
      "to": "设置界面",
      "expectStorage": {
        "gamemaker:settings": {
          "样式": "极光原野"
        }
      }
    },
    {
      "name": "选择极光原野背景并即时应用",
      "from": "设置界面",
      "action": "settings.background.极光原野",
      "to": "设置界面",
      "expectStorage": {
        "gamemaker:settings": {
          "背景主题": "极光原野"
        }
      }
    },
    {
      "name": "展开语言下拉菜单",
      "from": "设置界面",
      "action": "settings.language.dropdown",
      "to": "设置界面",
      "expectTextIncludes": [
        "English"
      ]
    },
    {
      "name": "切换英文界面",
      "from": "设置界面",
      "action": "settings.language.en",
      "to": "设置界面",
      "expectTextIncludes": [
        "Gameplay",
        "180° rotation"
      ],
      "expectStorage": {
        "gamemaker:settings": {
          "语言": "English"
        }
      }
    },
    {
      "name": "再次展开语言下拉菜单",
      "from": "设置界面",
      "action": "settings.language.dropdown",
      "to": "设置界面",
      "expectTextIncludes": [
        "简体中文"
      ]
    },
    {
      "name": "切换中文界面",
      "from": "设置界面",
      "action": "settings.language.zh",
      "to": "设置界面",
      "expectStorage": {
        "gamemaker:settings": {
          "语言": "简体中文"
        }
      }
    },
    {
      "name": "恢复默认设置",
      "from": "设置界面",
      "action": "settings.defaults",
      "to": "设置界面",
      "expectStorage": {
        "gamemaker:settings": {
          "背景音乐": true,
          "音乐音量": 60,
          "音效音量": 80,
          "旋转180": true,
          "主题": "跟随系统",
          "语言": "跟随系统",
          "样式": "夜空鎏金"
        }
      }
    },
    {
      "name": "完成并关闭",
      "from": "设置界面",
      "action": "settings.done",
      "to": "开始菜单"
    }
  ]
}
