{
  "version": 1,
  "name": "主界面功能流程",
  "initialState": "菜单",
  "timeoutMs": 8000,
  "steps": [
    {
      "name": "打开设置页面",
      "from": "菜单",
      "action": "设置",
      "to": "设置",
      "expectInteractives": { "返回主菜单": true }
    },
    {
      "name": "关闭设置并回到菜单",
      "from": "设置",
      "action": "返回主菜单",
      "to": "菜单"
    },
    {
      "name": "进入模式选择",
      "from": "菜单",
      "action": "开始游戏",
      "to": "模式选择",
      "expectTextIncludes": ["过渡:无"]
    },
    {
      "name": "从模式选择返回菜单",
      "from": "模式选择",
      "action": "返回",
      "to": "菜单"
    }
  ]
}
