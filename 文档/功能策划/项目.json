{
  "格式版本": 1,
  "编号": "one-more-line",
  "名称": "再消一行",
  "说明": "单机网页方块消除游戏《再消一行》。现行功能策划由原策划案与当前实现逐项补录；不将补录稿伪装为历史原稿。",
  "分组": [
    {
      "id": "core",
      "名称": "共用玩法",
      "说明": "棋盘、方块、随机、输入与所有模式共用的规则"
    },
    {
      "id": "modes",
      "名称": "游戏模式",
      "说明": "马拉松、冲刺、极限与每日挑战"
    },
    {
      "id": "experience",
      "名称": "界面与设置",
      "说明": "主菜单、对局界面、设置与触屏操作"
    },
    {
      "id": "presentation",
      "名称": "视觉与音频",
      "说明": "项目画风、动态反馈、音乐与音效"
    },
    {
      "id": "progress",
      "名称": "成就与纪录",
      "说明": "成就解锁、本地成绩与存档保护"
    }
  ],
  "功能文件": [
    "core-rules.json",
    "controls.json",
    "marathon.json",
    "sprint.json",
    "ultra.json",
    "daily-challenge.json",
    "menus-settings.json",
    "visual-feedback.json",
    "audio.json",
    "achievements-records.json",
    "travel-collection.json",
    "performance-board-layers.json",
    "performance-scenery.json",
    "performance-hud.json",
    "performance-idle.json",
    "performance-layer-quality.json"
  ],
