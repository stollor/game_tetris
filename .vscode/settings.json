{
  // 根目录只保留项目内容与运行入口；工程配置文件折叠到 package.json 下。
  // 只影响编辑器显示，不改磁盘结构，Bun / Biome / tsc / Git / GM 打包都照旧从根读取。
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "package.json": "bun.lock, bunfig.toml, tsconfig.json, biome.json, .gitignore, .gitattributes"
  },
  // 依赖不进视野；.gamemaker 是 GM 托管区，需要查看产物/报告时要在侧栏可见。
  "files.exclude": {
    "**/node_modules": true
  },
  // 搜索仍排除托管区与依赖，避免缓存文件淹没结果；需要时可在「搜索: 排除」里临时关掉。
  "search.exclude": {
    "**/.gamemaker": true,
    "**/node_modules": true,
    "**/bun.lock": true
  }
}
